		<character id="karen" onLandedOnTile="in" onApplyEffect="out"/>
		<character id="larry" onLandedOnTile="exercise" onApplyEffect="idle"/>
		<character id="squidward1" mc="squidward" onLandedOnTile="angry" onApplyEffect="idle"/>
		<character id="squidward2" mc="squidward" onLandedOnTile="flute" onApplyEffect="idle"/>

		<!-- if "spawnAt" is defined, the MC is the linkage of the movieclip -->
		<character id="patrick1" mc="boards.spongeBobBoard.patrick" spawnAt="0, -180" onLandedOnTile="in" onApplyEffect="steal"/>
		<character id="patrick2" mc="boards.spongeBobBoard.patrick" spawnAt="0, -180" onLandedOnTile="in" onApplyEffect="give"/>
		<character id="dutchMan" mc="boards.spongeBobBoard.flyingDutchman" spawnAt="-120, -50" onLandedOnTile="in" onApplyEffect="out"/>
	</characters>

	<outcomes>
		<!-- EFFECTS: -->
		<!-- "+{n}c" gives n coins -->
		<!-- "-{n}c" steals n coins -->
		<!-- "+c" gives random coins -->
		<!-- "-c" steals random coins -->
		<!-- "er" gives an extra roll -->
		<!-- "mgc" moves the gold coin -->
		<!-- "+gc" gives one gold coin -->
		<!-- "-gc" steals one gold coin -->
		<!--outcome tiles="krustyKrab" weight="20" messageId="krabMessage1"  avatarId="krab" effect="pc" character="krabs1"/-->
