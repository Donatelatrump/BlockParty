	<characters>
		<character id="sandy1" mc="sandy" onApplyEffect="punch"/>
		<character id="sandy2" mc="sandy" onApplyEffect="waving"/>
		<character id="krabs1" mc="krabs" onApplyEffect="askCoin"/>
		<character id="krabs2" mc="krabs" onApplyEffect="giveCoin"/>
		<character id="gary" onLandedOnTile="in" onApplyEffect="out"/>
