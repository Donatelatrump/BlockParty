		<challenges>8, 12, 22, 35, 40</challenges>
		<extraRolls>1, 6, 16, 24, 31, 44</extraRolls>
	</tiles>

	<challenges>patrick</challenges>

	<fxs>
		<fx id="bubbles" linkage="boards.spongeBob.bubbles" frequency="5-10" position="0-1, 0.6-1.5" duration="animation"/>
